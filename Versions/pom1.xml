<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.carlosbuss</groupId>
  <artifactId>magmaflow</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>MagmaFlow</name>
  <description>Publication-Ready Volcano Plots - Drag, Explore, Discover</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.3</javafx.version>
    <main.class>com.carlosbuss.Magmaflow</main.class>
    <app.icon>src/main/resources/MF_logo.ico</app.icon>
  </properties>

  <dependencies>
    <!-- JavaFX dependencies -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>MagmaFlow-${project.version}</finalName>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- jpackage: build a Windows EXE installer -->
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <name>MagmaFlow</name>
          <appVersion>${project.version}</appVersion>
          <vendor>Carlos Buss</vendor>

          <input>${project.build.directory}</input>
          <destination>C:\Users\Usuario\Desktop\MagmaFlow-installer</destination>

          <mainClass>${main.class}</mainClass>
          <mainJar>${project.build.finalName}.jar</mainJar>
          <icon>${app.icon}</icon>

          <type>EXE</type>

          <!-- launcher JVM options - BÁSICO sem JavaFX -->
          <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
            <option>-Xmx1024m</option>
            <option>-Djava.awt.headless=false</option>
          </javaOptions>

          <!-- Windows specific options -->
          <winDirChooser>true</winDirChooser>
          <winMenu>true</winMenu>
          <winShortcut>true</winShortcut>
          <winMenuGroup>Scientific Tools</winMenuGroup>
          <winPerUserInstall>false</winPerUserInstall>  <!-- Instalação global -->
          <winConsole>true</winConsole>  <!-- Console habilitado para debug -->
          <winUpgradeUuid>12345678-1234-1234-1234-123456789012</winUpgradeUuid>
        </configuration>

        <executions>
          <execution>
            <id>make-exe</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Use your downloaded JavaFX SDK -->
    <profile>
      <id>local-msi</id>
      <properties>
        <javafx.sdk.lib>${env.JAVAFX_SDK}</javafx.sdk.lib>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <!-- Supply JavaFX to the launcher via javaOptions -->
              <javaOptions>
                <option>-Dfile.encoding=UTF-8</option>
                <option>-Xmx1024m</option>
                <option>--module-path</option>
                <option>${javafx.sdk.lib}</option>
                <option>--add-modules</option>
                <option>javafx.base,javafx.graphics,javafx.controls,javafx.swing,javafx.fxml</option>
                <option>-Djava.awt.headless=false</option>
                <option>-Dprism.verbose=true</option>  <!-- Debug do JavaFX -->
              </javaOptions>
              <!-- Console habilitado para debug -->
              <winConsole>true</winConsole>
              <!-- Instalação global para acesso fácil -->
              <winPerUserInstall>false</winPerUserInstall>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- MSI profile for future use -->
    <profile>
      <id>msi</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <type>MSI</type>
              <destination>C:\Users\Usuario\Desktop\MagmaFlow-installer</destination>
              <javaOptions>
                <option>-Dfile.encoding=UTF-8</option>
                <option>-Xmx1024m</option>
                <option>--module-path</option>
                <option>${javafx.sdk.lib}</option>
                <option>--add-modules</option>
                <option>javafx.base,javafx.graphics,javafx.controls,javafx.swing,javafx.fxml</option>
                <option>-Djava.awt.headless=false</option>
              </javaOptions>
              <winConsole>true</winConsole>
              <winPerUserInstall>false</winPerUserInstall>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>