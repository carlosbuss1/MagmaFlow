name: Build Windows MSI Installer

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    name: Build MagmaFlow (Windows)

    # Force PowerShell Core for every step
    defaults:
      run:
        shell: pwsh

    env:
      APP_NAME: MagmaFlow
      APP_VERSION: "1.0.0"
      VENDOR: "Carlos Buss"
      COPYRIGHT: "Copyright 2025 Carlos Buss"
      JAVAFX_VERSION: "21.0.1"
      JAVAFX_URL: "https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip"
      JAVAFX_MODULES: "javafx.controls,javafx.fxml,javafx.web,javafx.swing"

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17 (Temurin)
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install WiX Toolset
        run: |
          choco install wixtoolset --no-progress -y
          $candidates = @(
            "${env:ProgramFiles(x86)}\WiX Toolset v3.14\bin",
            "${env:ProgramFiles(x86)}\WiX Toolset v3.11\bin",
            "${env:ProgramData}\chocolatey\lib\wixtoolset\tools"
          )
          $wix = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
          if (-not $wix) { throw "WiX Toolset not found after install." }
          Add-Content -Path $env:GITHUB_ENV -Value "WIX=$wix"

      - name: Download JavaFX SDK
        run: |
          Invoke-WebRequest -Uri "$env:JAVAFX_URL" -OutFile 'openjfx-sdk.zip'
          Expand-Archive -Path 'openjfx-sdk.zip' -DestinationPath '.'
          $sdkDir = "javafx-sdk-$($env:JAVAFX_VERSION)"
          if (!(Test-Path $sdkDir)) { throw "Expected folder $sdkDir after unzip, not found." }
          Rename-Item $sdkDir 'javafx-sdk' -Force
          $javafxPath = (Resolve-Path '.\javafx-sdk\lib').Path
          if (!(Test-Path $javafxPath)) { throw "JavaFX lib folder not found: $javafxPath" }
          Add-Content -Path $env:GITHUB_ENV -Value "JAVAFX_PATH=$javafxPath"
          Get-ChildItem $javafxPath

      - name: Verify source files
        run: |
          if (!(Test-Path 'src\main\java')) { throw 'src\main\java not found' }
          $javaFiles = Get-ChildItem -Recurse -Path 'src\main\java' -Filter '*.java'
          if ($javaFiles.Count -eq 0) { throw 'No .java files found under src\main\java' }
          "Found $($javaFiles.Count) Java source files" | Write-Host

      - name: Compile (javac)
        run: |
          New-Item -ItemType Directory -Force -Path 'build\classes' | Out-Null
          Get-ChildItem -Recurse -Path 'src\main\java' -Filter '*.java' |
            ForEach-Object { $_.FullName } | Set-Content -Path 'sources.txt' -Encoding utf8

          if (-not (Test-Path $env:JAVAFX_PATH)) { throw "JAVAFX_PATH invalid: $env:JAVAFX_PATH" }

          & javac `
            --module-path "$env:JAVAFX_PATH" `
            --add-modules "$env:JAVAFX_MODULES" `
            -encoding UTF-8 `
            -d 'build\classes' `
            @sources.txt

          if ($LASTEXITCODE -ne 0) { throw 'Compilation failed' }
          if (Test-Path 'build\classes\com\carlosbuss') { Get-ChildItem -Recurse 'build\classes\com\carlosbuss' }

      - name: Detect main class
        run: |
          $c1 = 'build\classes\com\carlosbuss\Magmaflow.class'
          $c2 = 'build\classes\com\carlosbuss\MagmaFlow.class'
          if    (Test-Path $c1) { $main = 'com.carlosbuss.Magmaflow' }
          elseif (Test-Path $c2) { $main = 'com.carlosbuss.MagmaFlow' }
          else {
            Get-ChildItem -Recurse 'build\classes' | ForEach-Object { $_.FullName }
            throw 'Main class not found (Magmaflow or MagmaFlow).'
          }
          Add-Content -Path $env:GITHUB_ENV -Value "MAIN_CLASS=$main"

      - name: Create JAR
        run: |
          New-Item -ItemType Directory -Force -Path 'dist' | Out-Null
          $jarName = "$env:APP_NAME-windows.jar"
          & jar --create `
                --file "dist\$jarName" `
                --main-class "$env:MAIN_CLASS" `
                -C 'build\classes' .
          if ($LASTEXITCODE -ne 0) { throw 'JAR creation failed' }
          Get-Item "dist\$jarName" | Select-Object Name,Length,LastWriteTime

      - name: Package MSI (jpackage)
        run: |
          $jar = "dist\$env:APP_NAME-windows.jar"
          if (!(Test-Path $jar)) { throw "JAR not found: $jar" }
          if (-not (Test-Path $env:WIX)) { throw "WIX not set or invalid: $env:WIX" }
          $env:PATH = "$env:WIX;$env:PATH"

          $iconPath = ".github\icons\app.ico"
          $args = @(
            '--type','msi',
            '--name', $env:APP_NAME,
            '--app-version', $env:APP_VERSION,
            '--input','dist',
            '--main-jar', "$env:APP_NAME-windows.jar",
            '--main-class', $env:MAIN_CLASS,
            '--module-path', $env:JAVAFX_PATH,
            '--add-modules', $env:JAVAFX_MODULES,
            '--dest','dist',
            '--vendor', $env:VENDOR,
            '--copyright', $env:COPYRIGHT,
            '--win-menu',
            '--win-shortcut',
            '--win-dir-chooser',
            '--win-per-user-install',
            '--java-options','-Dfile.encoding=UTF-8',
            '--java-options','-Xmx2048m'
          )
          if (Test-Path $iconPath) { $args += @('--icon', $iconPath) }
          & jpackage @args
          if ($LASTEXITCODE -ne 0) { throw 'jpackage failed' }
          Get-ChildItem 'dist\*.msi'

      - name: Create INSTALL notes
        run: |
          $content = @"
$($env:APP_NAME) Installation (Windows)
======================================

System Requirements: Windows 10+
Java Version (runtime): 17
JavaFX Version: $($env:JAVAFX_VERSION)

Install:
1) Download the MSI from the workflow artifacts
2) Double-click to run and follow the wizard
3) Launch from the Start Menu or Desktop shortcut

Troubleshooting:
- If SmartScreen shows a warning: click 'More info' → 'Run anyway'
- Try running as Administrator if your IT policy blocks installs
"@
          $path = "dist\INSTALL-Windows.txt"
          $content | Set-Content -Path $path -Encoding utf8
          Get-Item $path | Select-Object Name,Length,LastWriteTime

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: MagmaFlow-Windows
          path: |
            dist\*.msi
            dist\*.jar
            dist\INSTALL-*.txt
          retention-days: 90

      - name: Debug info (on failure)
        if: failure()
        run: |
          "PWD: $(Get-Location)" | Write-Host
          "Build dir:" | Write-Host
          if (Test-Path 'build') { Get-ChildItem -Recurse -Force 'build' } else { '(no build dir)' | Write-Host }
          "Dist dir:" | Write-Host
          if (Test-Path 'dist') { Get-ChildItem -Recurse -Force 'dist' } else { '(no dist dir)' | Write-Host }
          'Java version:' | Write-Host
          & java -version 2>&1 | ForEach-Object { Write-Host $_ }
          'jpackage version:' | Write-Host
          & jpackage --version 2>&1 | ForEach-Object { Write-Host $_ }
          'WIX:' | Write-Host
          Write-Host $env:WIX
          'JavaFX PATH:' | Write-Host
          Write-Host $env:JAVAFX_PATH
          if (Test-Path 'sources.txt') { 'sources.txt:' | Write-Host; Get-Content 'sources.txt' }
