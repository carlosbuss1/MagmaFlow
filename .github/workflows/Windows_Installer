name: Build Windows MSI Installer

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    name: 🪟 Build MagmaFlow (Windows 10+)

    env:
      APP_NAME: MagmaFlow
      APP_VERSION: "1.0.0"
      VENDOR: "Carlos Buss"
      COPYRIGHT: "Copyright 2025 Carlos Buss"
      MAIN_PKG: "com.carlosbuss"
      # JavaFX 21 (Windows x64 SDK)
      JAVAFX_VERSION: "21.0.1"
      JAVAFX_ZIP: "openjfx-21.0.1_windows-x64_bin-sdk.zip"
      JAVAFX_URL: "https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip"
      # JavaFX modules commonly used
      JAVAFX_MODULES: "javafx.controls,javafx.fxml,javafx.web,javafx.swing"

    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: ☕ Set up JDK 17 (Temurin)
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: 'gradle'

      - name: 🧰 Install WiX Toolset (for MSI)
        shell: powershell
        run: |
          choco install wixtoolset --no-progress -y
          $wix = "${env:ProgramFiles(x86)}\WiX Toolset v3.11\bin"
          if (!(Test-Path $wix)) {
            # Newer Chocolatey locations (3.14.x)
            $wix = "${env:ProgramData}\chocolatey\lib\wixtoolset\tools"
          }
          if (!(Test-Path $wix)) { Write-Error "WiX Toolset not found after install."; exit 1 }
          "WIX=$wix" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append

      - name: 📦 Download JavaFX SDK
        shell: powershell
        run: |
          Invoke-WebRequest -Uri "$env:JAVAFX_URL" -OutFile "openjfx-sdk.zip"
          Expand-Archive -Path "openjfx-sdk.zip" -DestinationPath "."
          $sdkDir = "javafx-sdk-$env:JAVAFX_VERSION"
          if (!(Test-Path $sdkDir)) { Write-Error "Expected $sdkDir after unzip, not found."; exit 1 }
          Rename-Item $sdkDir "javafx-sdk"
          $libPath = (Resolve-Path ".\javafx-sdk\lib").Path
          "JAVAFX_PATH=$libPath" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
          Write-Host "JavaFX lib: $libPath"
          Get-ChildItem $libPath

      - name: 🔍 Verify Source Files
        shell: powershell
        run: |
          if (!(Test-Path "src\main\java")) { Write-Error "src\main\java not found"; exit 1 }
          $javaFiles = Get-ChildItem -Recurse -Path "src\main\java" -Filter "*.java"
          if ($javaFiles.Count -eq 0) { Write-Error "No .java files found under src\main\java"; exit 1 }
          Write-Host "Found $($javaFiles.Count) Java source files."

      - name: 🔨 Compile (javac)
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path "build\classes" | Out-Null
          Get-ChildItem -Recurse -Path "src\main\java" -Filter "*.java" | ForEach-Object { $_.FullName } | Set-Content -Path "sources.txt" -Encoding utf8

          $modulePath = $env:JAVAFX_PATH
          if (-not (Test-Path $modulePath)) { Write-Error "JAVAFX_PATH not set or invalid: $modulePath"; exit 1 }

          & javac `
            --module-path "$modulePath" `
            --add-modules "$env:JAVAFX_MODULES" `
            -encoding UTF-8 `
            -d "build\classes" `
            @"sources.txt"

          if ($LASTEXITCODE -ne 0) { Write-Error "Compilation failed"; exit 1 }
          Write-Host "✅ Compilation OK"
          if (Test-Path "build\classes\com\carlosbuss") { Get-ChildItem -Recurse "build\classes\com\carlosbuss" }

      - name: 🧭 Detect Main Class
        id: mainclass
        shell: powershell
        run: |
          $c1 = "build\classes\com\carlosbuss\Magmaflow.class"
          $c2 = "build\classes\com\carlosbuss\MagmaFlow.class"
          if (Test-Path $c1) {
            $main = "com.carlosbuss.Magmaflow"
          } elseif (Test-Path $c2) {
            $main = "com.carlosbuss.MagmaFlow"
          } else {
            Write-Host "Classes under build\classes:"
            Get-ChildItem -Recurse "build\classes" | ForEach-Object { $_.FullName }
            Write-Error "Main class not found (Magmaflow or MagmaFlow)."
            exit 1
          }
          "MAIN_CLASS=$main" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
          Write-Host "Main class: $main"

      - name: 📦 Create JAR
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path "dist" | Out-Null
          $jarName = "$env:APP_NAME-windows.jar"

          & jar --create `
                --file "dist\$jarName" `
                --main-class "$env:MAIN_CLASS" `
                -C "build\classes" .

          if ($LASTEXITCODE -ne 0) { Write-Error "JAR creation failed"; exit 1 }
          Write-Host "✅ JAR created: dist\$jarName"
          Get-Item "dist\$jarName" | Select-Object Name,Length,LastWriteTime

      - name: 🏗️ Package MSI (jpackage)
        shell: powershell
        run: |
          $jar = "dist\$env:APP_NAME-windows.jar"
          if (!(Test-Path $jar)) { Write-Error "JAR not found: $jar"; exit 1 }

          # Ensure WiX on PATH for jpackage MSI backend
          $wix = $env:WIX
          if (!(Test-Path $wix)) { Write-Error "WIX environment variable not set or invalid: $wix"; exit 1 }
          $env:PATH = "$wix;$env:PATH"

          # Output dir
          New-Item -ItemType Directory -Force -Path "dist" | Out-Null

          & jpackage `
            --type msi `
            --name "$env:APP_NAME" `
            --app-version "$env:APP_VERSION" `
            --input "dist" `
            --main-jar "$env:APP_NAME-windows.jar" `
            --main-class "$env:MAIN_CLASS" `
            --module-path "$env:JAVAFX_PATH" `
            --add-modules "$env:JAVAFX_MODULES" `
            --dest "dist" `
            --vendor "$env:VENDOR" `
            --copyright "$env:COPYRIGHT" `
            --win-menu `
            --win-shortcut `
            --win-dir-chooser `
            --win-per-user-install `
            --icon ".github\icons\app.ico" `
            --java-options "-Dfile.encoding=UTF-8" `
            --java-options "-Xmx2048m"

          if ($LASTEXITCODE -ne 0) { Write-Error "jpackage failed"; exit 1 }
          Write-Host "✅ MSI created"
          Get-ChildItem "dist\*.msi"

      - name: 📝 Create INSTALL notes
        shell: powershell
        run: |
          $content = @"
$($env:APP_NAME) Installation (Windows)
======================================

System Requirements: Windows 10+
Java Version (bundled launcher): 17
JavaFX Version: $($env:JAVAFX_VERSION)

Install:
1) Download the MSI from the workflow artifacts
2) Double-click to run and follow the wizard
3) Launch from the Start Menu or Desktop shortcut

Troubleshooting:
- If SmartScreen shows a warning: click 'More info' → 'Run anyway'
- Try running as Administrator if your IT policy blocks installs

Built with ❤️ by Carlos Buss
"@
          $path = "dist\INSTALL-Windows.txt"
          $content | Set-Content -Path $path -Encoding utf8
          Get-Item $path | Select-Object Name,Length,LastWriteTime

      - name: ⬆️ Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: MagmaFlow-Windows
          path: |
            dist\*.msi
            dist\*.jar
            dist\INSTALL-*.txt
          retention-days: 90
