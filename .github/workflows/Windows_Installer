name: Build Windows MSI (clean)

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: windows-latest

    # Force every run step to PowerShell Core
    defaults:
      run:
        shell: pwsh

    env:
      APP_NAME: MagmaFlow
      APP_VERSION: "1.0.0"
      VENDOR: "Carlos Buss"
      COPYRIGHT: "Copyright 2025 Carlos Buss"
      JAVAFX_VERSION: "21.0.1"
      JAVAFX_URL: "https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip"
      JAVAFX_MODULES: "javafx.controls,javafx.fxml,javafx.web,javafx.swing"

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install WiX
        run: |
          choco install wixtoolset --no-progress -y
          $candidates = @(
            "${env:ProgramFiles(x86)}\WiX Toolset v3.14\bin",
            "${env:ProgramFiles(x86)}\WiX Toolset v3.11\bin",
            "${env:ProgramData}\chocolatey\lib\wixtoolset\tools"
          )
          $wix = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
          if (-not $wix) { throw "WiX not found after install." }
          Add-Content -Path $env:GITHUB_ENV -Value "WIX=$wix"

      - name: Download JavaFX (Windows)
        run: |
          Invoke-WebRequest -Uri "$env:JAVAFX_URL" -OutFile 'openjfx-sdk.zip'
          Expand-Archive -Path 'openjfx-sdk.zip' -DestinationPath '.'
          $sdkDir = "javafx-sdk-$($env:JAVAFX_VERSION)"
          if (!(Test-Path $sdkDir)) { throw "Expected folder $sdkDir after unzip." }
          Rename-Item $sdkDir 'javafx-sdk' -Force
          $javafxPath = (Resolve-Path '.\javafx-sdk\lib').Path
          if (!(Test-Path $javafxPath)) { throw "JavaFX lib not found: $javafxPath" }
          Add-Content -Path $env:GITHUB_ENV -Value "JAVAFX_PATH=$javafxPath"
          Get-ChildItem $javafxPath

      - name: Verify sources
        run: |
          if (!(Test-Path 'src\main\java')) { throw 'src\main\java not found' }
          $list = Get-ChildItem -Recurse -Path 'src\main\java' -Filter '*.java'
          if ($list.Count -eq 0) { throw 'No .java sources found' }
          "Sources: $($list.Count)" | Write-Host

      - name: Compile
        run: |
          New-Item -ItemType Directory -Force -Path 'build\classes' | Out-Null
          Get-ChildItem -Recurse -Path 'src\main\java' -Filter '*.java' |
            ForEach-Object { $_.FullName } | Set-Content -Path 'sources.txt' -Encoding utf8
          if (-not (Test-Path $env:JAVAFX_PATH)) { throw "JAVAFX_PATH invalid: $env:JAVAFX_PATH" }
          & javac `
            --module-path "$env:JAVAFX_PATH" `
            --add-modules "$env:JAVAFX_MODULES" `
            -encoding UTF-8 `
            -d 'build\classes' `
            @sources.txt
          if ($LASTEXITCODE -ne 0) { throw 'Compilation failed' }
          if (Test-Path 'build\classes\com\carlosbuss') { Get-ChildItem -Recurse 'build\classes\com\carlosbuss' }

      - name: Detect main class
        run: |
          $c1 = 'build\classes\com\carlosbuss\Magmaflow.class'
          $c2 = 'build\classes\com\carlosbuss\MagmaFlow.class'
          if    (Test-Path $c1) { $main = 'com.carlosbuss.Magmaflow' }
          elseif (Test-Path $c2) { $main = 'com.carlosbuss.MagmaFlow' }
          else { throw 'Main class not found (Magmaflow/MagmaFlow).' }
          Add-Content -Path $env:GITHUB_ENV -Value "MAIN_CLASS=$main"

      - name: Create JAR
        run: |
          New-Item -ItemType Directory -Force -Path 'dist' | Out-Null
          $jarName = "$env:APP_NAME-windows.jar"
          & jar --create `
                --file "dist\$jarName" `
                --main-class "$env:MAIN_CLASS" `
                -C 'build\classes' .
          if ($LASTEXITCODE -ne 0) { throw 'JAR creation failed' }
          Get-Item "dist\$jarName" | Select-Object Name,Length,LastWriteTime

      - name: Package MSI (jpackage)
        run: |
          $jar = "dist\$env:APP_NAME-windows.jar"
          if (!(Test-Path $jar)) { throw "JAR not found: $jar" }
          if (-not (Test-Path $env:WIX)) { throw "WIX invalid: $env:WIX" }
          $env:PATH = "$env:WIX;$env:PATH"

          $iconPath = ".github\icons\app.ico"
          $args = @(
            '--type','msi',
            '--name', $env:APP_NAME,
            '--app-version', $env:APP_VERSION,
            '--input','dist',
            '--main-jar', "$env:APP_NAME-windows.jar",
            '--main-class', $env:MAIN_CLASS,
            '--module-path', $env:JAVAFX_PATH,
            '--add-modules', $env:JAVAFX_MODULES,
            '--dest','dist',
            '--vendor', $env:VENDOR,
            '--copyright', $env:COPYRIGHT,
            '--win-menu',
            '--win-shortcut',
            '--win-dir-chooser',
            '--win-per-user-install',
            '--java-options','-Dfile.encoding=UTF-8',
            '--java-options','-Xmx2048m'
          )
          if (Test-Path $iconPath) { $args += @('--icon', $iconPath) }
          & jpackage @args
          if ($LASTEXITCODE -ne 0) { throw 'jpackage failed' }
          Get-ChildItem 'dist\*.msi'

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: MagmaFlow-Windows
          path: |
            dist\*.msi
            dist\*.jar
          retention-days: 30
