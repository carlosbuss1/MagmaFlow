name: 🚀 Build Legacy-Compatible Multi-Platform

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    strategy:
      matrix:
        include:
          # Modern builds for recent systems
          - os: macos-latest
            platform: mac-modern
            java-version: '17'
            javafx-version: '21.0.1'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_osx-x64_bin-sdk.zip
            installer-type: dmg
            artifact-name: MagmaFlow-macOS-Modern
            min-system: "macOS 10.14+"
            
          - os: windows-latest
            platform: windows-modern
            java-version: '17'
            javafx-version: '21.0.1'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Modern
            min-system: "Windows 10+"
            
          # Legacy builds for older systems
          - os: macos-latest
            platform: mac-legacy
            java-version: '11'
            javafx-version: '11.0.2'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_osx-x64_bin-sdk.zip
            installer-type: pkg
            artifact-name: MagmaFlow-macOS-Legacy
            min-system: "macOS 10.10+"
            
          - os: windows-latest
            platform: windows-legacy
            java-version: '11'
            javafx-version: '11.0.2'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Legacy
            min-system: "Windows 7+"
    
    runs-on: ${{ matrix.os }}
    name: 🔨 Build ${{ matrix.platform }} (${{ matrix.min-system }})
    
    steps:
    - name: 📥 Checkout Repository
      uses: actions/checkout@v4
    
    - name: ☕ Set up JDK ${{ matrix.java-version }}
      uses: actions/setup-java@v4
      with:
        java-version: ${{ matrix.java-version }}
        distribution: 'temurin'
    
    - name: 📦 Download JavaFX SDK (macOS)
      if: contains(matrix.platform, 'mac')
      run: |
        echo "📦 Downloading JavaFX ${{ matrix.javafx-version }} for macOS..."
        curl -L -o openjfx-sdk.zip "${{ matrix.javafx-url }}"
        unzip -q openjfx-sdk.zip
        mv javafx-sdk-${{ matrix.javafx-version }} javafx-sdk
        echo "JAVAFX_PATH=$(pwd)/javafx-sdk/lib" >> $GITHUB_ENV
        ls -la javafx-sdk/lib/
    
    - name: 📦 Download JavaFX SDK (Windows)
      if: contains(matrix.platform, 'windows')
      run: |
        echo "📦 Downloading JavaFX ${{ matrix.javafx-version }} for Windows..."
        Invoke-WebRequest -Uri "${{ matrix.javafx-url }}" -OutFile "openjfx-sdk.zip"
        Expand-Archive -Path "openjfx-sdk.zip" -DestinationPath "."
        Rename-Item "javafx-sdk-${{ matrix.javafx-version }}" "javafx-sdk"
        echo "JAVAFX_PATH=$(Get-Location)\javafx-sdk\lib" >> $env:GITHUB_ENV
        Get-ChildItem "javafx-sdk\lib"
      shell: powershell
    
    - name: 🔍 Verify Source Files
      run: |
        echo "🔍 Checking source files for ${{ matrix.platform }}..."
        find src/ -name "*.java" -type f 2>/dev/null || Get-ChildItem -Recurse -Path "src\" -Filter "*.java" 2>$null || echo "Checking with fallback method..."
        
        # Check main class specifically
        if [ -f "src/main/java/com/carlosbuss/Magmaflow.java" ]; then
          echo "✅ Found Magmaflow.java"
        elif [ -f "src/main/java/com/carlosbuss/MagmaFlow.java" ]; then
          echo "✅ Found MagmaFlow.java"
        else
          echo "❌ Main class file not found!"
          find src/ -name "*.java" 2>/dev/null || echo "No Java files found"
        fi
      shell: bash
    
    - name: 🔨 Compile JavaFX Application
      run: |
        echo "🔨 Compiling for ${{ matrix.platform }} with Java ${{ matrix.java-version }}..."
        mkdir -p build/classes
        
        # Find Java source files
        if command -v find >/dev/null 2>&1; then
          find src/main/java -name "*.java" > sources.txt
        else
          # Windows PowerShell fallback
          Get-ChildItem -Recurse -Path "src\main\java" -Filter "*.java" | ForEach-Object { $_.FullName } | Out-File -FilePath "sources.txt" -Encoding utf8
        fi
        
        # Check if we found any source files
        if [ -s sources.txt ]; then
          echo "Found source files:"
          cat sources.txt || type sources.txt
          
          # Determine JavaFX modules based on version
          if [ "${{ matrix.java-version }}" = "11" ]; then
            MODULES="javafx.controls,javafx.fxml,javafx.web"
          else
            MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
          fi
          
          javac --module-path "$JAVAFX_PATH" \
                --add-modules "$MODULES" \
                -d build/classes \
                @sources.txt
          
          if [ $? -eq 0 ]; then
            echo "✅ Compilation successful for ${{ matrix.platform }}"
            ls -la build/classes/com/carlosbuss/ || dir "build\classes\com\carlosbuss\"
          else
            echo "❌ Compilation failed!"
            exit 1
          fi
        else
          echo "❌ No Java source files found!"
          exit 1
        fi
      shell: bash
    
    - name: 📦 Create JAR File
      run: |
        echo "📦 Creating executable JAR for ${{ matrix.platform }}..."
        mkdir -p dist
        
        # Check if classes were compiled
        if [ ! -d "build/classes" ] || [ -z "$(ls -A build/classes 2>/dev/null)" ]; then
          echo "❌ No compiled classes found!"
          exit 1
        fi
        
        # Determine main class (handle both naming conventions)
        if [ -f "build/classes/com/carlosbuss/Magmaflow.class" ]; then
          MAIN_CLASS="com.carlosbuss.Magmaflow"
        elif [ -f "build/classes/com/carlosbuss/MagmaFlow.class" ]; then
          MAIN_CLASS="com.carlosbuss.MagmaFlow"
        else
          echo "❌ Could not find main class!"
          ls -la build/classes/com/carlosbuss/ || dir "build\classes\com\carlosbuss\"
          exit 1
        fi
        
        echo "Using main class: $MAIN_CLASS"
        
        jar --create \
            --file "dist/MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            -C build/classes .
        
        echo "✅ JAR created successfully"
        ls -lh "dist/MagmaFlow-${{ matrix.platform }}.jar" || dir "dist\MagmaFlow-${{ matrix.platform }}.jar"
      shell: bash
    
    - name: 🏗️ Create Application Bundle/Installer
      run: |
        echo "🏗️ Creating installer for ${{ matrix.platform }}..."
        
        JAR_FILE="dist/MagmaFlow-${{ matrix.platform }}.jar"
        
        if [ ! -f "$JAR_FILE" ] || [ ! -s "$JAR_FILE" ]; then
          echo "❌ JAR file missing or empty!"
          exit 1
        fi
        
        # Clean output directory
        rm -rf app_output
        mkdir -p app_output
        
        # Determine main class
        if [ -f "build/classes/com/carlosbuss/Magmaflow.class" ]; then
          MAIN_CLASS="com.carlosbuss.Magmaflow"
        else
          MAIN_CLASS="com.carlosbuss.MagmaFlow"
        fi
        
        # Determine JavaFX modules
        if [ "${{ matrix.java-version }}" = "11" ]; then
          MODULES="javafx.controls,javafx.fxml,javafx.web"
        else
          MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
        fi
        
        # Create installer with appropriate options for legacy compatibility
        if [ "${{ matrix.platform }}" = "mac-legacy" ]; then
          # For older macOS, create PKG instead of DMG
          jpackage \
            --type pkg \
            --name "MagmaFlow-Legacy" \
            --app-version "1.0.0" \
            --input dist/ \
            --main-jar "MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            --module-path "$JAVAFX_PATH" \
            --add-modules "$MODULES" \
            --dest dist/ \
            --vendor "Carlos Buss" \
            --copyright "Copyright 2024 Carlos Buss" \
            --java-options "-Xmx1024m -XX:+UseG1GC"
        elif [ "${{ matrix.platform }}" = "windows-legacy" ]; then
          # For older Windows
          jpackage \
            --type msi \
            --name "MagmaFlow-Legacy" \
            --app-version "1.0.0" \
            --input dist/ \
            --main-jar "MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            --module-path "$JAVAFX_PATH" \
            --add-modules "$MODULES" \
            --dest dist/ \
            --vendor "Carlos Buss" \
            --copyright "Copyright 2024 Carlos Buss" \
            --java-options "-Xmx1024m" \
            --win-dir-chooser \
            --win-menu \
            --win-shortcut
        else
          # Modern versions
          jpackage \
            --type ${{ matrix.installer-type }} \
            --name "MagmaFlow" \
            --app-version "1.0.0" \
            --input dist/ \
            --main-jar "MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            --module-path "$JAVAFX_PATH" \
            --add-modules "$MODULES" \
            --dest dist/ \
            --vendor "Carlos Buss" \
            --copyright "Copyright 2024 Carlos Buss" \
            --java-options "-Xmx2048m"
        fi
        
        echo "✅ Installer created for ${{ matrix.platform }}"
        ls -lh dist/*.dmg dist/*.pkg dist/*.msi 2>/dev/null || dir "dist\*.msi" 2>nul || echo "Checking installer files..."
      shell: bash
    
    - name: 📝 Create Installation Instructions
      run: |
        echo "📝 Creating installation instructions..."
        
        cat > "dist/INSTALL-${{ matrix.platform }}.txt" << EOF
        MagmaFlow Installation Instructions (${{ matrix.platform }})
        ================================================================
        
        System Requirements: ${{ matrix.min-system }}
        Java Version: ${{ matrix.java-version }}
        JavaFX Version: ${{ matrix.javafx-version }}
        
        Installation:
        EOF
        
        if [[ "${{ matrix.platform }}" == *"mac"* ]]; then
          cat >> "dist/INSTALL-${{ matrix.platform }}.txt" << EOF
        1. Download and open the installer file
        2. Follow the installation wizard
        3. Launch MagmaFlow from Applications folder
        
        Security Note (macOS):
        - If you see "App can't be opened": Right-click → Open → Open
        - Or: System Preferences → Security & Privacy → "Open Anyway"
        EOF
        else
          cat >> "dist/INSTALL-${{ matrix.platform }}.txt" << EOF
        1. Download the MSI installer
        2. Double-click to run the installer
        3. Follow the installation wizard
        4. Launch from Start Menu or Desktop shortcut
        
        Security Note (Windows):
        - If Windows Defender warns: Click "More info" → "Run anyway"
        - Or temporarily disable real-time protection during install
        EOF
        fi
        
        cat >> "dist/INSTALL-${{ matrix.platform }}.txt" << EOF
        
        Troubleshooting:
        - Ensure you meet the minimum system requirements
        - Check that no antivirus is blocking the installation
        - For older systems, try running as administrator
        
        Built with ❤️ by Carlos Buss
        GitHub: https://github.com/carlosbuss1/MagmaFlow
        EOF
        
        echo "✅ Installation instructions created"
      shell: bash
    
    - name: ⬆️ Upload Installer
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}
        path: |
          dist/*.dmg
          dist/*.pkg
          dist/*.msi
          dist/INSTALL-*.txt
        retention-days: 90
      if: success()
    
    - name: ⬆️ Upload JAR (Fallback)
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}-JAR
        path: |
          dist/MagmaFlow-*.jar
          dist/INSTALL-*.txt
        retention-days: 90
      if: success()
    
    - name: 📋 Debug Information
      if: failure()
      run: |
        echo "🔍 Debug information for ${{ matrix.platform }}:"
        echo "Current directory:"
        ls -la || dir
        echo "Build directory:"
        ls -la build/ 2>/dev/null || dir build\ 2>nul || echo "No build directory"
        echo "Dist directory:"
        ls -la dist/ 2>/dev/null || dir dist\ 2>nul || echo "No dist directory"
        echo "Java version:"
        java --version
        echo "JavaFX path: $JAVAFX_PATH"
        echo "Source files found:"
        cat sources.txt 2>/dev/null || type sources.txt 2>nul || echo "No sources.txt file"
      shell: bash
