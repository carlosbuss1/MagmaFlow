name: Build Multi-Platform Installers

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    strategy:
      matrix:
        include:
          # Modern builds
          - os: macos-latest
            platform: mac-modern
            java-version: '17'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_osx-x64_bin-sdk.zip
            installer-type: dmg
            artifact-name: MagmaFlow-macOS-Modern
            
          - os: windows-latest
            platform: windows-modern
            java-version: '17'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Modern
            
          # Legacy builds
          - os: macos-latest
            platform: mac-legacy
            java-version: '11'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_osx-x64_bin-sdk.zip
            installer-type: pkg
            artifact-name: MagmaFlow-macOS-Legacy
            
          - os: windows-latest
            platform: windows-legacy
            java-version: '11'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Legacy
    
    runs-on: ${{ matrix.os }}
    name: Build ${{ matrix.platform }}
    
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4
    
    - name: Set up JDK
      uses: actions/setup-java@v4
      with:
        java-version: ${{ matrix.java-version }}
        distribution: 'temurin'
    
    - name: Download JavaFX (macOS)
      if: contains(matrix.platform, 'mac')
      run: |
        curl -L -o javafx.zip "${{ matrix.javafx-url }}"
        unzip -q javafx.zip
        mv javafx-sdk-* javafx-sdk
        echo "JAVAFX_PATH=$(pwd)/javafx-sdk/lib" >> $GITHUB_ENV
    
    - name: Download JavaFX (Windows)
      if: contains(matrix.platform, 'windows')
      run: |
        Invoke-WebRequest -Uri "${{ matrix.javafx-url }}" -OutFile "javafx.zip"
        Expand-Archive -Path "javafx.zip" -DestinationPath "."
        Get-ChildItem -Name "javafx-sdk-*" | Rename-Item -NewName "javafx-sdk"
        $javafxPath = "$(Get-Location)\javafx-sdk\lib"
        echo "JAVAFX_PATH=$javafxPath" >> $env:GITHUB_ENV
      shell: powershell
    
    - name: Find Source Files
      run: |
        echo "=== Debugging Repository Structure ==="
        echo "Current directory contents:"
        ls -la
        echo ""
        echo "Looking for source directories:"
        find . -type d -name "*java*" 2>/dev/null || echo "No java directories found with find"
        echo ""
        echo "Looking for .java files recursively:"
        find . -name "*.java" -type f 2>/dev/null || echo "No .java files found with find"
        echo ""
        echo "Checking common source locations:"
        ls -la src/ 2>/dev/null || echo "No src/ directory"
        ls -la src/main/ 2>/dev/null || echo "No src/main/ directory"
        ls -la src/main/java/ 2>/dev/null || echo "No src/main/java/ directory"
        ls -la . | grep -i java || echo "No java files in root"
        
        # Try to find the main class file
        MAIN_FILE=""
        
        # Check standard Maven structure first
        if [ -f "src/main/java/com/carlosbuss/MagmaFlow.java" ]; then
          MAIN_FILE="src/main/java/com/carlosbuss/MagmaFlow.java"
          echo "Found: $MAIN_FILE"
        elif [ -f "src/main/java/com/carlosbuss/Magmaflow.java" ]; then
          MAIN_FILE="src/main/java/com/carlosbuss/Magmaflow.java"
          echo "Found: $MAIN_FILE"
        # Check alternative structures
        elif [ -f "src/com/carlosbuss/MagmaFlow.java" ]; then
          MAIN_FILE="src/com/carlosbuss/MagmaFlow.java"
          echo "Found: $MAIN_FILE"
        elif [ -f "src/com/carlosbuss/Magmaflow.java" ]; then
          MAIN_FILE="src/com/carlosbuss/Magmaflow.java"
          echo "Found: $MAIN_FILE"
        # Check root directory
        elif [ -f "MagmaFlow.java" ]; then
          MAIN_FILE="MagmaFlow.java"
          echo "Found: $MAIN_FILE"
        elif [ -f "Magmaflow.java" ]; then
          MAIN_FILE="Magmaflow.java"
          echo "Found: $MAIN_FILE"
        else
          echo "ERROR: Could not find main Java source file!"
          echo "Please ensure your Java source file exists in one of these locations:"
          echo "  - src/main/java/com/carlosbuss/MagmaFlow.java"
          echo "  - src/main/java/com/carlosbuss/Magmaflow.java"
          echo "  - src/com/carlosbuss/MagmaFlow.java"
          echo "  - MagmaFlow.java (in root)"
          exit 1
        fi
        
        echo "MAIN_FILE=$MAIN_FILE" >> $GITHUB_ENV
        echo "Selected main file: $MAIN_FILE"
      shell: bash
    
    - name: Compile Application
      run: |
        echo "=== Starting Compilation ==="
        echo "Main file: $MAIN_FILE"
        echo "JavaFX path: $JAVAFX_PATH"
        
        # Create build directory
        mkdir -p build/classes
        
        # Determine source directory structure
        if [[ "$MAIN_FILE" == src/main/java/* ]]; then
          SOURCEPATH="src/main/java"
          PACKAGE_STRUCTURE="src/main/java"
        elif [[ "$MAIN_FILE" == src/* ]]; then
          SOURCEPATH="src"
          PACKAGE_STRUCTURE="src"
        else
          SOURCEPATH="."
          PACKAGE_STRUCTURE="."
        fi
        
        echo "Using sourcepath: $SOURCEPATH"
        
        # Determine modules based on Java version
        if [ "${{ matrix.java-version }}" = "11" ]; then
          MODULES="javafx.controls,javafx.fxml,javafx.web"
        else
          MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
        fi
        
        echo "Using modules: $MODULES"
        
        # Compile with more verbose output
        echo "Compiling $MAIN_FILE..."
        javac --module-path "$JAVAFX_PATH" \
              --add-modules "$MODULES" \
              -d build/classes \
              -cp "$SOURCEPATH" \
              -verbose \
              "$MAIN_FILE"
        
        COMPILE_RESULT=$?
        echo "Compilation result: $COMPILE_RESULT"
        
        if [ $COMPILE_RESULT -eq 0 ]; then
          echo "Compilation successful!"
          echo "Build directory contents:"
          find build/classes -type f -name "*.class" 2>/dev/null || echo "No .class files found"
        else
          echo "Compilation failed!"
          exit 1
        fi
      shell: bash
    
    - name: Determine Main Class
      run: |
        echo "=== Determining Main Class ==="
        echo "Looking for compiled classes..."
        find build/classes -name "*.class" -type f || echo "No .class files found"
        
        # Check for various possible main class locations
        MAIN_CLASS=""
        
        if [ -f "build/classes/com/carlosbuss/MagmaFlow.class" ]; then
          MAIN_CLASS="com.carlosbuss.MagmaFlow"
          echo "Found main class: $MAIN_CLASS"
        elif [ -f "build/classes/com/carlosbuss/Magmaflow.class" ]; then
          MAIN_CLASS="com.carlosbuss.Magmaflow"
          echo "Found main class: $MAIN_CLASS"
        elif [ -f "build/classes/MagmaFlow.class" ]; then
          MAIN_CLASS="MagmaFlow"
          echo "Found main class: $MAIN_CLASS"
        elif [ -f "build/classes/Magmaflow.class" ]; then
          MAIN_CLASS="Magmaflow"
          echo "Found main class: $MAIN_CLASS"
        else
          echo "ERROR: No compiled main class found!"
          echo "Expected locations:"
          echo "  - build/classes/com/carlosbuss/MagmaFlow.class"
          echo "  - build/classes/com/carlosbuss/Magmaflow.class"
          echo "  - build/classes/MagmaFlow.class"
          echo "  - build/classes/Magmaflow.class"
          echo ""
          echo "Actual build/classes contents:"
          find build/classes -type f 2>/dev/null || echo "build/classes directory is empty or doesn't exist"
          exit 1
        fi
        
        echo "MAIN_CLASS=$MAIN_CLASS" >> $GITHUB_ENV
        echo "Using main class: $MAIN_CLASS"
      shell: bash
    
    - name: Create JAR
      run: |
        mkdir -p dist
        
        jar --create \
            --file "dist/MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            -C build/classes .
        
        echo "JAR file created:"
        ls -lh "dist/MagmaFlow-${{ matrix.platform }}.jar"
      shell: bash
    
    - name: Create Installer
      run: |
        echo "Creating installer for ${{ matrix.platform }}..."
        
        # Determine modules
        if [ "${{ matrix.java-version }}" = "11" ]; then
          MODULES="javafx.controls,javafx.fxml,javafx.web"
        else
          MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
        fi
        
        # Create installer
        jpackage \
          --type ${{ matrix.installer-type }} \
          --name "MagmaFlow" \
          --app-version "1.0.0" \
          --input dist/ \
          --main-jar "MagmaFlow-${{ matrix.platform }}.jar" \
          --main-class "$MAIN_CLASS" \
          --module-path "$JAVAFX_PATH" \
          --add-modules "$MODULES" \
          --dest dist/ \
          --vendor "Carlos Buss" \
          --copyright "Copyright 2024 Carlos Buss" \
          --java-options "-Xmx1024m"
        
        echo "Installer created:"
        ls -lh dist/*.dmg dist/*.pkg dist/*.msi 2>/dev/null || echo "Checking for installer files..."
      shell: bash
    
    - name: Upload Installer
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}
        path: |
          dist/*.dmg
          dist/*.pkg
          dist/*.msi
        retention-days: 90
      if: success()
    
    - name: Upload JAR
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}-JAR
        path: dist/MagmaFlow-*.jar
        retention-days: 90
      if: success()
    
    - name: Debug Info
      if: failure()
      run: |
        echo "Debug information:"
        echo "Working directory:"
        ls -la
        echo "Source files:"
        find src/ -name "*.java" 2>/dev/null || echo "No Java files found"
        echo "Build directory:"
        ls -la build/ 2>/dev/null || echo "No build directory"
        echo "Environment variables:"
        echo "JAVAFX_PATH: $JAVAFX_PATH"
        echo "MAIN_CLASS: $MAIN_CLASS"
        echo "MAIN_FILE: $MAIN_FILE"
      shell: bash
