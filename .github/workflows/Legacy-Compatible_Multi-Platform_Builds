name: Build Multi-Platform Installers

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    strategy:
      matrix:
        include:
          # Modern builds
          - os: macos-latest
            platform: mac-modern
            java-version: '17'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_osx-x64_bin-sdk.zip
            installer-type: dmg
            artifact-name: MagmaFlow-macOS-Modern
            
          - os: windows-latest
            platform: windows-modern
            java-version: '17'
            javafx-url: https://download2.gluonhq.com/openjfx/21.0.1/openjfx-21.0.1_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Modern
            
          # Legacy builds
          - os: macos-latest
            platform: mac-legacy
            java-version: '11'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_osx-x64_bin-sdk.zip
            installer-type: pkg
            artifact-name: MagmaFlow-macOS-Legacy
            
          - os: windows-latest
            platform: windows-legacy
            java-version: '11'
            javafx-url: https://download2.gluonhq.com/openjfx/11.0.2/openjfx-11.0.2_windows-x64_bin-sdk.zip
            installer-type: msi
            artifact-name: MagmaFlow-Windows-Legacy
    
    runs-on: ${{ matrix.os }}
    name: Build ${{ matrix.platform }}
    
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4
    
    - name: Set up JDK
      uses: actions/setup-java@v4
      with:
        java-version: ${{ matrix.java-version }}
        distribution: 'temurin'
    
    - name: Download JavaFX (macOS)
      if: contains(matrix.platform, 'mac')
      run: |
        curl -L -o javafx.zip "${{ matrix.javafx-url }}"
        unzip -q javafx.zip
        mv javafx-sdk-* javafx-sdk
        echo "JAVAFX_PATH=$(pwd)/javafx-sdk/lib" >> $GITHUB_ENV
    
    - name: Download JavaFX (Windows)
      if: contains(matrix.platform, 'windows')
      run: |
        Invoke-WebRequest -Uri "${{ matrix.javafx-url }}" -OutFile "javafx.zip"
        Expand-Archive -Path "javafx.zip" -DestinationPath "."
        Get-ChildItem -Name "javafx-sdk-*" | Rename-Item -NewName "javafx-sdk"
        $javafxPath = "$(Get-Location)\javafx-sdk\lib"
        echo "JAVAFX_PATH=$javafxPath" >> $env:GITHUB_ENV
      shell: powershell
    
    - name: Find Source Files
      shell: bash
      run: |
        echo "Debugging Repository Structure"
        echo "Current directory contents:"
        ls -la
        echo "Looking for Java files:"
        find . -name "*.java" -type f 2>/dev/null || echo "No Java files found"
        
        MAIN_FILE=""
        if [ -f "src/main/java/com/carlosbuss/MagmaFlow.java" ]; then
          MAIN_FILE="src/main/java/com/carlosbuss/MagmaFlow.java"
        elif [ -f "src/main/java/com/carlosbuss/Magmaflow.java" ]; then
          MAIN_FILE="src/main/java/com/carlosbuss/Magmaflow.java"
        elif [ -f "src/com/carlosbuss/MagmaFlow.java" ]; then
          MAIN_FILE="src/com/carlosbuss/MagmaFlow.java"
        elif [ -f "src/com/carlosbuss/Magmaflow.java" ]; then
          MAIN_FILE="src/com/carlosbuss/Magmaflow.java"
        elif [ -f "MagmaFlow.java" ]; then
          MAIN_FILE="MagmaFlow.java"
        elif [ -f "Magmaflow.java" ]; then
          MAIN_FILE="Magmaflow.java"
        else
          echo "ERROR: Could not find Java source file"
          exit 1
        fi
        
        echo "MAIN_FILE=$MAIN_FILE" >> $GITHUB_ENV
        echo "Found main file: $MAIN_FILE"
    
    - name: Compile Application
      shell: bash
      run: |
        echo "Starting compilation"
        echo "Main file: $MAIN_FILE"
        
        mkdir -p build/classes
        
        if [ "${{ matrix.java-version }}" = "11" ]; then
          MODULES="javafx.controls,javafx.fxml,javafx.web"
        else
          MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
        fi
        
        # Determine source path
        if [[ "$MAIN_FILE" == src/main/java/* ]]; then
          SOURCEPATH="src/main/java"
        elif [[ "$MAIN_FILE" == src/* ]]; then
          SOURCEPATH="src"
        else
          SOURCEPATH="."
        fi
        
        javac --module-path "$JAVAFX_PATH" \
              --add-modules "$MODULES" \
              -d build/classes \
              -cp "$SOURCEPATH" \
              "$MAIN_FILE"
        
        if [ $? -eq 0 ]; then
          echo "Compilation successful"
          find build/classes -name "*.class" -type f
        else
          echo "Compilation failed"
          exit 1
        fi
    
    - name: Determine Main Class
      shell: bash
      run: |
        echo "Looking for main class"
        find build/classes -name "*.class" -type f
        
        if [ -f "build/classes/com/carlosbuss/MagmaFlow.class" ]; then
          MAIN_CLASS="com.carlosbuss.MagmaFlow"
        elif [ -f "build/classes/com/carlosbuss/Magmaflow.class" ]; then
          MAIN_CLASS="com.carlosbuss.Magmaflow"
        elif [ -f "build/classes/MagmaFlow.class" ]; then
          MAIN_CLASS="MagmaFlow"
        elif [ -f "build/classes/Magmaflow.class" ]; then
          MAIN_CLASS="Magmaflow"
        else
          echo "No compiled main class found"
          exit 1
        fi
        
        echo "MAIN_CLASS=$MAIN_CLASS" >> $GITHUB_ENV
        echo "Using main class: $MAIN_CLASS"
    
    - name: Create JAR
      shell: bash
      run: |
        mkdir -p dist
        
        jar --create \
            --file "dist/MagmaFlow-${{ matrix.platform }}.jar" \
            --main-class "$MAIN_CLASS" \
            -C build/classes .
        
        echo "JAR created:"
        ls -lh "dist/MagmaFlow-${{ matrix.platform }}.jar"
    
    - name: Create Installer
      shell: bash
      run: |
        echo "Creating installer for ${{ matrix.platform }}"
        
        if [ "${{ matrix.java-version }}" = "11" ]; then
          MODULES="javafx.controls,javafx.fxml,javafx.web"
        else
          MODULES="javafx.controls,javafx.fxml,javafx.web,javafx.swing"
        fi
        
        jpackage \
          --type ${{ matrix.installer-type }} \
          --name "MagmaFlow" \
          --app-version "1.0.0" \
          --input dist/ \
          --main-jar "MagmaFlow-${{ matrix.platform }}.jar" \
          --main-class "$MAIN_CLASS" \
          --module-path "$JAVAFX_PATH" \
          --add-modules "$MODULES" \
          --dest dist/ \
          --vendor "Carlos Buss" \
          --copyright "Copyright 2024 Carlos Buss" \
          --java-options "-Xmx1024m"
        
        echo "Installer created"
        ls -lh dist/
    
    - name: Upload Installer
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}
        path: |
          dist/*.dmg
          dist/*.pkg
          dist/*.msi
        retention-days: 90
      if: success()
    
    - name: Upload JAR
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.artifact-name }}-JAR
        path: dist/MagmaFlow-*.jar
        retention-days: 90
      if: success()
    
    - name: Debug Info
      if: failure()
      shell: bash
      run: |
        echo "Debug information:"
        ls -la
        find . -name "*.java" -type f 2>/dev/null || echo "No Java files"
        ls -la build/ 2>/dev/null || echo "No build directory"
        echo "JAVAFX_PATH: $JAVAFX_PATH"
        echo "MAIN_CLASS: $MAIN_CLASS"
        echo "MAIN_FILE: $MAIN_FILE"
